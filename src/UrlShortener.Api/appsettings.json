{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shortener": {
    "BaseUrl": "http://localhost:5260",
    "CodeLength": 7,
    "MaxGenerationAttempts": 5,
    "MaxUrlLength": 2048,
    "MaxExpiryDays": 365,
    "BlockedHosts": []
  },
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=urlshortener.db",
    "CacheTtlSeconds": 60,
    "CacheSizeLimit": 100000
  },
  "Security": {
    "AdminApiKey": null
  },
  "Analytics": {
    "VisitorHashKey": "",
    "BufferCapacity": 10000,
    "BatchSize": 500,
    "FlushIntervalMilliseconds": 1000,
    "StatsWindowDays": 30,
    "TopReferrers": 10
  },
  "RateLimiting": {
    "Enabled": true,
    "CreatePermitsPerMinute": 20,
    "RedirectPermitsPerMinute": 300
  }
}

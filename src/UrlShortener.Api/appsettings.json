{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shortener": {
    "BaseUrl": "http://localhost:5260",
    "CodeLength": 7,
    "MaxGenerationAttempts": 5,
    "MaxUrlLength": 2048
  },
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=urlshortener.db",
    "CacheTtlSeconds": 60,
    "CacheSizeLimit": 100000
  },
  "Security": {
    "AdminApiKey": null
  }
}
